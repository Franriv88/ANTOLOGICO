{
  "buildCommand": "pnpm --filter @antologico/web-tenant build:demo",
  "outputDirectory": "apps/web-tenant/dist",
  "installCommand": "npm install -g pnpm@9.15.4 && pnpm install",
  "routes": [
    {
      "src": "/.well-known/assetlinks.json",
      "headers": { "Content-Type": "application/json" },
      "dest": "/.well-known/assetlinks.json"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

# Copiá como .env y completá con los valores de Firebase Console
EXPO_NO_METRO_WORKSPACE_ROOT=1
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=antologico.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=antologico
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=antologico.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google OAuth Web Client ID (de Firebase Console > Authentication > Sign-in method > Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

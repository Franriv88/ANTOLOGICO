# Copiá este archivo como .env.local y completá con los valores de tu proyecto Firebase.
# En modo DEV (npm run dev) el emulador local no requiere un apiKey real —
# los valores por defecto en firebase.js funcionan sin este archivo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=antologico.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=antologico
VITE_FIREBASE_STORAGE_BUCKET=antologico.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

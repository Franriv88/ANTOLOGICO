generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Planes de suscripción (gestionados por Super Admin) ────────────────────

model Plan {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(100)
  precioMensual Decimal       @db.Decimal(10, 2)
  precioAnual   Decimal       @db.Decimal(10, 2)
  features      Json
  activo        Boolean       @default(true)
  profesionales Profesional[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("planes")
}

// ─── Profesionales (Tenants) ─────────────────────────────────────────────────

model Profesional {
  id           Int                  @id @default(autoincrement())
  nombre       String               @db.VarChar(200)
  email        String               @unique @db.VarChar(255)
  googleId     String?              @unique @db.VarChar(255)
  planId       Int?
  plan         Plan?                @relation(fields: [planId], references: [id])
  // Token del método de pago (Mercado Pago), nunca datos de tarjeta en crudo
  metodoPagoToken String?          @db.VarChar(255)
  template     String?              @db.VarChar(100)
  estado       EstadoProfesional    @default(ACTIVO)
  dominio      Dominio?
  workshops    Workshop[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("profesionales")
}

enum EstadoProfesional {
  ACTIVO
  SUSPENDIDO
  INACTIVO
}

// ─── Dominios personalizados ─────────────────────────────────────────────────

model Dominio {
  id               Int           @id @default(autoincrement())
  profesionalId    Int           @unique
  profesional      Profesional   @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  urlPersonalizada String        @unique @db.VarChar(255)
  estado           EstadoDominio @default(PENDIENTE)
  sslActivo        Boolean       @default(false)
  nameservers      Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("dominios")
}

enum EstadoDominio {
  PENDIENTE
  ACTIVO
  ERROR
}

// ─── Talleres ────────────────────────────────────────────────────────────────

model Workshop {
  id               Int            @id @default(autoincrement())
  profesionalId    Int
  profesional      Profesional    @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  nombre           String         @db.VarChar(200)
  categoria        String?        @db.VarChar(100)
  descripcion      String?        @db.Text
  cuposTotales     Int
  cuposDisponibles Int
  precio           Decimal        @db.Decimal(10, 2)
  fecha            DateTime
  // Personalización de encabezado según plan (ver handoff §6)
  headerType       HeaderType     @default(COLOR)
  headerValue      String?        @db.VarChar(500)
  estado           EstadoWorkshop @default(BORRADOR)
  reservas         Reserva[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("workshops")
}

enum HeaderType {
  COLOR
  IMAGE
}

enum EstadoWorkshop {
  BORRADOR
  PUBLICADO
  CANCELADO
  FINALIZADO
}

// ─── Usuarios finales (Mobile) ───────────────────────────────────────────────

model Usuario {
  id                  Int           @id @default(autoincrement())
  nombre              String        @db.VarChar(200)
  email               String        @unique @db.VarChar(255)
  googleId            String?       @unique @db.VarChar(255)
  estado              EstadoUsuario @default(ACTIVO)
  notifReservas       Boolean       @default(true)
  notifRecordatorios  Boolean       @default(true)
  reservas            Reserva[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("usuarios")
}

enum EstadoUsuario {
  ACTIVO
  SUSPENDIDO
}

// ─── Reservas ────────────────────────────────────────────────────────────────

model Reserva {
  id             Int           @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])
  workshopId     Int
  workshop       Workshop      @relation(fields: [workshopId], references: [id])
  fechaReserva   DateTime      @default(now())
  estado         EstadoReserva @default(PENDIENTE)
  comprobanteUrl String?       @db.VarChar(500)
  // ID del pago en Mercado Pago
  pagoExternoId  String?       @db.VarChar(255)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("reservas")
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

// ─── Super Admins ────────────────────────────────────────────────────────────

model SuperAdmin {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(200)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colecciones del demo — lectura y escritura pública para permitir
    // vista pública y reservas desde el celular sin autenticación real.
    match /demo_espacios/{id} {
      allow read, write: if true;
    }
    match /demo_workshops/{id} {
      allow read, write: if true;
    }
    match /demo_reservas/{id} {
      allow read, write: if true;
    }
    match /demo_meta/{id} {
      allow read, write: if true;
    }
    match /demo_planes/{id} {
      allow read, write: if true;
    }
    match /demo_usuarios/{id} {
      allow read, write: if true;
    }
    match /sa_admins/{id} {
      allow read, write: if true;
    }
    match /demo_config/{id} {
      allow read, write: if true;
    }
    match /demo_promo/{id} {
      allow read, write: if true;
    }
    match /demo_promo_codes/{id} {
      allow read, write: if true;
    }
    match /demo_rubros/{id} {
      allow read, write: if true;
    }
    match /demo_cupones/{id} {
      allow read, write: if true;
    }

    // Sesiones revocadas: el tenant puede leer y borrar su propio doc.
    // Escritura solo desde Cloud Functions o Super Admin (sa_admins).
    match /revoked_sessions/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/sa_admins/$(request.auth.uid));
    }

    // Todo lo demás: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

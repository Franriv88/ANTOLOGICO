{
  "name": "antologico",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:api":     "pnpm --filter @antologico/api dev",
    "dev:web":     "pnpm --filter @antologico/web-tenant dev",
    "db:migrate":  "pnpm --filter @antologico/api db:migrate",
    "db:seed":     "pnpm --filter @antologico/api db:seed",
    "db:studio":   "pnpm --filter @antologico/api db:studio",
    "db:generate": "pnpm --filter @antologico/api db:generate"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
